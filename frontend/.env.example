NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-local-development-secret
AUTH_TRUST_HOST=true
# Distributed authentication limiter trust boundary (shared with the backend)
# AUTH_LIMITER_HMAC_SECRET=
# AUTH_LIMITER_ASSERTION_SECRET=
AUTH_LIMITER_HMAC_KEY_VERSION=1
# Number of trailing X-Forwarded-For entries appended by the trusted platform.
# The Google Cloud external Application Load Balancer appends exactly two
# entries (<client-ip>,<load-balancer-ip>), so production uses 2 and the
# client is the first of those trailing entries. The final entry (the load
# balancer address) is never selected as the client.
# "0" (default) applies the conservative missing-source policy in dev.
AUTH_LIMITER_TRUSTED_FORWARDED_HOPS=0
