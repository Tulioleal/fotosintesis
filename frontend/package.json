{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "openapi:export": "if [ -x ../backend/.venv/bin/python ]; then ../backend/.venv/bin/python ../backend/scripts/export_openapi.py src/lib/generated/openapi.json; else python3 ../backend/scripts/export_openapi.py src/lib/generated/openapi.json; fi",
    "openapi:generate": "pnpm openapi:export && openapi-typescript src/lib/generated/openapi.json -o src/lib/generated/openapi.d.ts",
    "openapi:check": "node scripts/check-openapi.mjs",
    "typecheck": "tsc --noEmit",
    "check:auth-deps": "node scripts/check-auth-dependencies.mjs",
    "smoke:auth-failclosed": "node scripts/smoke-auth-failclosed.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test --config=playwright.auth.config.ts",
    "test:e2e:enrichment": "playwright test e2e/enrichment-journeys.spec.ts --workers=1"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.62.11",
    "next": "15.5.21",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sass": "^1.83.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "9",
    "@next/eslint-plugin-next": "15.5.18",
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/parser": "8",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.1.8"
  }
}
