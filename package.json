{
  "name": "fotosintesis-ai",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "eval": "pnpm --dir backend exec python scripts/run_evaluation.py --mode recorded",
    "fallow": "pnpx fallow",
    "e2e:enrichment": "sh scripts/run-enrichment-e2e.sh"
  },
  "pnpm": {
    "overrides": {
      "next>sharp": "0.35.0",
      "next>postcss": "8.5.23",
      "postcss>nanoid": "3.3.18",
      "sass>immutable": "5.1.8"
    }
  }
}