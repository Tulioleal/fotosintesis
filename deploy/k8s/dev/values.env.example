# Copy to values.env and fill from `tofu output` for infra/opentofu/envs/dev.
# BACKEND_IMAGE_TAG and FRONTEND_IMAGE_TAG must be the full 40-character
# Git commit SHA that the dev CI workflow pushed. Never use `latest` or a
# branch name; the deploy workflow refuses anything that is not a SHA.
NAMESPACE=fotosintesis
APP_ENV=dev
IMAGE_REGISTRY=us-central1-docker.pkg.dev/example-project/fotosintesis
BACKEND_IMAGE_TAG=0000000000000000000000000000000000000000
FRONTEND_IMAGE_TAG=0000000000000000000000000000000000000000
BACKEND_REPLICAS=1
FRONTEND_REPLICAS=1
FRONTEND_SERVICE_TYPE=ClusterIP
FRONTEND_API_BASE_URL=http://fotosintesis-backend:8000
FRONTEND_SERVER_API_BASE_URL=http://fotosintesis-backend:8000
FRONTEND_EXPOSURE_MODE=ip-http
FRONTEND_HOSTNAME=
STATIC_IP_NAME=fotosintesis-dev-frontend-ip
MANAGED_CERTIFICATE_NAME=fotosintesis-managed-cert
BACKEND_GCP_SERVICE_ACCOUNT_EMAIL=fotosintesis-backend-dev@example-project.iam.gserviceaccount.com
FRONTEND_GCP_SERVICE_ACCOUNT_EMAIL=fotosintesis-frontend-dev@example-project.iam.gserviceaccount.com
OBJECT_STORAGE_PROVIDER=gcs
OBJECT_STORAGE_BUCKET=example-fotosintesis-storage
CLOUD_SQL_INSTANCE_CONNECTION_NAME=example-project:us-central1:fotosintesis-dev
CLOUD_SQL_DATABASE_NAME=fotosintesis
CLOUD_SQL_PROXY_IMAGE=gcr.io/cloud-sql-connectors/cloud-sql-proxy:2.15.2
CLOUD_SQL_PROXY_PORT=5432
DATABASE_URL_SECRET_KEY=database-url
AUTH_SECRET_SECRET_KEY=auth-secret
AUTH_LIMITER_HMAC_SECRET_KEY=auth-limiter-hmac-secret
AUTH_LIMITER_ASSERTION_SECRET_KEY=auth-limiter-assertion-secret
AUTH_LIMITER_ENABLED=false
AUTH_LIMITER_HMAC_KEY_VERSION=1
AUTH_LIMITER_MAX_RETRY_AFTER_SECONDS=3600
AUTH_LIMITER_RETENTION_SECONDS=86400
AUTH_LIMITER_CLEANUP_BATCH_SIZE=1000
AUTH_LIMITER_PROFILES='{"registration":{"source":{"limit":10,"window_seconds":3600},"account":null,"storage_failure_mode":"fail_closed"},"credential_verification":{"source":{"limit":30,"window_seconds":300},"account":{"limit":5,"window_seconds":300},"storage_failure_mode":"fail_closed"},"recovery_initiation":{"source":{"limit":5,"window_seconds":3600},"account":{"limit":2,"window_seconds":3600},"storage_failure_mode":"fail_closed"},"recovery_confirmation":{"source":{"limit":5,"window_seconds":300},"account":{"limit":2,"window_seconds":3600},"storage_failure_mode":"fail_closed"},"authjs_post":{"source":{"limit":20,"window_seconds":300},"account":null,"storage_failure_mode":"fail_closed"}}'
# Dev has no trusted ingress, so no forwarding entries are trusted.
AUTH_LIMITER_TRUSTED_FORWARDED_HOPS=0
EXTERNAL_SECRETS_STORE_NAME=fotosintesis-secret-store
EXTERNAL_SECRETS_REFRESH_INTERVAL=5m
GCP_PROJECT_ID=example-project
MODEL_PROVIDER=mock
VISION_PROVIDER=mock
JUDGE_PROVIDER=mock
SEARCH_PROVIDER=mock
EMBEDDING_PROVIDER=mock
MODEL_PROVIDERS='["mock"]'
VISION_PROVIDERS='["mock"]'
JUDGE_PROVIDERS='["mock"]'
SEARCH_PROVIDERS='["mock"]'
OPENAI_TEXT_MODEL=gpt-5.4
OPENAI_VISION_MODEL=gpt-5.4
OPENAI_JUDGE_MODEL=gpt-5.4
OPENAI_SEARCH_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSION=8
ENRICHMENT_ACTIVITY_TERMINAL_RETENTION_HOURS=24
ENRICHMENT_ACTIVITY_MAX_ITEMS=20
RUNTIME_SECRET_NAME=fotosintesis-runtime
# AUTH_URL is derived by deploy.yml from the frontend_static_ip_address;
# set a placeholder for manual rendering.
AUTH_URL=http://203.0.113.10
# Durable background jobs (normal deployed operation enables both roles)
JOBS_PRODUCER_ENABLED=true
JOBS_WORKER_ENABLED=true
JOBS_POLL_INTERVAL_SECONDS=5
JOBS_BATCH_SIZE=10
JOBS_WORKER_CONCURRENCY=5
JOBS_LEASE_DURATION_SECONDS=300
JOBS_LEASE_RENEWAL_INTERVAL_SECONDS=60
JOBS_MAX_ATTEMPTS_DEFAULT=3
JOBS_BACKOFF_BASE_SECONDS=10
JOBS_BACKOFF_CAP_SECONDS=3600
JOBS_SHUTDOWN_DRAIN_SECONDS=30
JOBS_METRICS_HOST=0.0.0.0
JOBS_METRICS_PORT=9100
JOBS_REQUIRED_CONTRACTS=enrich_confirmed_plant:1,refresh_profile:1
JOBS_TERMINATION_GRACE_PERIOD_SECONDS=90
# Container resource profiles (requests and limits per role). All values are
# explicit; the renderer fails when any is absent so no container relies on an
# implicit default. Environments may diverge independently.
BACKEND_CPU_REQUEST=200m
BACKEND_MEM_REQUEST=256Mi
BACKEND_CPU_LIMIT=1000m
BACKEND_MEM_LIMIT=1024Mi
FRONTEND_CPU_REQUEST=100m
FRONTEND_MEM_REQUEST=128Mi
FRONTEND_CPU_LIMIT=500m
FRONTEND_MEM_LIMIT=512Mi
WORKER_CPU_REQUEST=200m
WORKER_MEM_REQUEST=256Mi
WORKER_CPU_LIMIT=1000m
WORKER_MEM_LIMIT=1536Mi
MIGRATION_CPU_REQUEST=200m
MIGRATION_MEM_REQUEST=256Mi
MIGRATION_CPU_LIMIT=1000m
MIGRATION_MEM_LIMIT=1024Mi
LIMITER_CLEANUP_CPU_REQUEST=50m
LIMITER_CLEANUP_MEM_REQUEST=64Mi
LIMITER_CLEANUP_CPU_LIMIT=500m
LIMITER_CLEANUP_MEM_LIMIT=256Mi
PROXY_CPU_REQUEST=100m
PROXY_MEM_REQUEST=64Mi
PROXY_CPU_LIMIT=500m
PROXY_MEM_LIMIT=256Mi
GKE_CLUSTER_PROJECT_ID=gke-project-id
GKE_CLUSTER_LOCATION=us-central1
GKE_CLUSTER_NAME=gke-cluster-name
